{
  "name": "grungus",
  "productName": "Grungus",
  "version": "0.21.1",
  "private": true,
  "description": "A Discord-style desktop chat client that speaks the Matrix protocol",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && electron . --smoke",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fletch13/grungus.git"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "fletch13",
  "license": "MIT",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@matrix-org/olm": "^3.2.15",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.22.4",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
